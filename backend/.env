APP_NAME=kfm_lms
APP_ENV=production
APP_KEY=base64:zmU8mHN2QVDMu5APWu/lHIW+OFsU/FTn70avyQmkJUE=
# Debug OFF = faster backend (no stack traces / debug overhead). Set true only when debugging.
APP_DEBUG=true
# Set to false in production for much faster admin/frontend (no debug overhead). Use true only when debugging.
APP_VERSION=1.8
# For local dev use: APP_URL=http://127.0.0.1:8000 or http://localhost:8000
APP_URL=https://lms.rocket-soft.org/
LOG_CHANNEL=stack
JWT_SECRET=zDg3RLGdt0xOR1Kqhjw3iFiVLv5npnxFfb26dBWa4DcL4ByH6qH6DseVMf9l3Vcy
# Must match frontend VITE_API_KEY (sent as x-api-key on every /api request)
API_KEY=1234

# Optional: faster admin panel. Uncomment if you have Redis; otherwise file cache is used.
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis

# Serve React app from this backend (single URL). When true, same URL serves React + API; /admin stays Laravel.
# After enabling: run "npm run build:laravel" in frontend, then copy frontend/dist/* to backend/public/spa/ (including index.html)
SERVE_REACT_FROM_BACKEND=true

# React frontend URL. When SERVE_REACT_FROM_BACKEND is true, leave empty (same origin). When false, set for CORS and "Login as user" redirects.
# FRONTEND_URL=http://127.0.0.1:8080
#payment gateway settings

   RAZORPAY_API_KEY=rzp_test_SMNYXRneQiVfQt    # or live key
   RAZORPAY_API_SECRET=n9S9svyvTbYOAld4xQII1wau

# Database Settings
 DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kfm_lms
DB_USERNAME=root
DB_PASSWORD=

# SMTP Settings
# Leave MAIL_HOST empty to log emails to storage/logs/laravel.log (no connection attempted).
# To send real mail (e.g. Gmail): set MAIL_HOST, use App Password for Gmail (myaccount.google.com/apppasswords).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=ashutosh@gmail.com
MAIL_PASSWORD=Ashutosh@123
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ashutosh@gmail.com
MAIL_FROM_NAME="Platform Title"

# Filesystem: use "local" so course thumbnails, images, and content uploads use server (system) storage.
# Do not set to s3/minio if you want course creation uploads to stay on local disk.
FILESYSTEM_DRIVER=local

# S3 Storage (optional; course file manager and LFM use local "upload" disk)
MINIO_KEY=
MINIO_SECRET=
MINIO_REGION=

MINIO_BUCKET=
MINIO_ENDPOINT=

# Facebook Authentication
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT=/facebook/callback

# Google Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=/google/callback

# -------------Payment Gateways------------------

# Paypal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD


# Payu
PAYU_DEFAULT_GATEWAY=money
PAYU_MONEY_MODE=test
PAYU_MONEY_KEY=
PAYU_MONEY_SALT=
PAYU_MONEY_AUTH=

